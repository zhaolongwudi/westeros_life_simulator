# 构建 APK 并直发邮箱的配置模板
# 复制为 .mail_env 并填写真实值（.mail_env 已被 .gitignore 忽略，不会推送）
# 注意：SMTP_PASS 是邮箱授权码（QQ 邮箱等需在设置里生成），不是登录密码

SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=你的邮箱@qq.com
SMTP_PASS=你的授权码
MAIL_FROM=你的邮箱@qq.com
MAIL_TO=收件人邮箱@example.com
# REPO=zhaolongwudi/westeros_life_simulator   # 可省略，默认此值
# GITHUB_TOKEN=                                # 可省略：默认从 git remote 提取